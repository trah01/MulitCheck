{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/settings.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
